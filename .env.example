# Required. Buying agents and the judge call Claude with live web search.
ANTHROPIC_API_KEY=
# Audit trail, scoreboard and lessons. Run schema.sql first. Without it the trail is in memory only.
SINGLESTORE_URL=
# Optional event tracking.
AMPLITUDE_API_KEY=
# Optional tuning.
BOSS_MODEL=claude-sonnet-5-5
BOSS_MAX_SEARCHES=3
BOSS_PRICE_JUMP_USD=5
# Set to 0 to skip the pre-approval price and stock re-check, or the vague-request question.
BOSS_VERIFY_CHECKOUT=1
BOSS_ASK_WHEN_VAGUE=1

# Optional: Cognee long-term memory. Needs: pip install "cognee[anthropic]"
COGNEE_ENABLED=0
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
# Optional: Superlinked SIE reranker. Needs: pip install sie-sdk (Python 3.12+)
SIE_API_KEY=
SIE_BASE_URL=
SIE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
